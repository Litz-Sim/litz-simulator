{
	"name": "litz-simulator",
	"version": "0.0.1",
	"private": true,
	"packageManager": "pnpm@11.21.0",
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"firmware": "node scripts/fetch-firmware.mjs",
		"dev": "node scripts/fetch-firmware.mjs && vite dev",
		"build": "node scripts/fetch-firmware.mjs && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^3.2.2",
		"@mdsvex/plugin-anchors": "^0.1.0",
		"@mdsvex/plugin-callouts": "^0.1.0",
		"@mdsvex/plugin-citations": "^0.1.0",
		"@mdsvex/plugin-code-blocks": "^0.1.0",
		"@mdsvex/plugin-diagram": "^0.1.0",
		"@mdsvex/plugin-elements": "^0.1.0",
		"@mdsvex/plugin-external-links": "^0.1.0",
		"@mdsvex/plugin-figures": "^0.1.0",
		"@mdsvex/plugin-page-data": "^0.1.0",
		"@mdsvex/plugin-steps": "^0.1.0",
		"@mdsvex/plugin-tabs": "^0.1.0",
		"@mdsvex/plugin-toc": "^0.1.0",
		"@mdsvex/prettier-plugin": "^0.1.0",
		"@sveltejs/adapter-auto": "^8.0.1",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^5.1.0",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"mdsvex": "^1.0.0",
		"mermaid": "^12.3.0",
		"playwright": "^1.65.1",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.0",
		"vitest-browser-svelte": "^3.1.0"
	},
	"dependencies": {
		"@codemirror/autocomplete": "^6.20.4",
		"@codemirror/commands": "^6.11.1",
		"@codemirror/lang-cpp": "^6.0.3",
		"@codemirror/lang-python": "^6.2.1",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.15",
		"@litz-sim/litz": "^0.9.0",
		"@lucide/svelte": "^1.77.0",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/xterm": "^6.0.0",
		"aws4fetch": "^1.0.20",
		"codemirror": "^6.0.2",
		"fflate": "^0.8.3",
		"lucide-svelte": "^1.0.1"
	}
}
